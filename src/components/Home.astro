---
// Homepage body (overview). Uses the shared SiteHeader/SiteFooter.
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';

interface Props {
  t: any;
  locale: string;
}
const { t, locale } = Astro.props;
const base = locale === 'de' ? '' : `/${locale}`;
const pageHref = (s: string) => (s ? `${base}/${s}` : (base === '' ? '/' : `${base}/`));

// Hero slides, locale-independent: the alt text is matched BY INDEX against t.hero.alts,
// so both locales must keep that array the same length as this one.
const heroSlides = ['zementverladung', 'betonrohre'];
const HERO_WIDTHS = [768, 1280, 1920, 2688];
const heroSrcset = (name: string) => HERO_WIDTHS.map((w) => `/media/${name}-${w}.webp ${w}w`).join(', ');
---

<SiteHeader t={t} locale={locale} slug="" />

<!-- ============ HERO ============ -->
<section class="hero" id="top">
  <div class="hero-media">
    <!-- Rotating stills (client request, 2026-07-23). Full-bleed and the LCP element, so
         each is served responsively; only the first is high priority, the rest load after.
         The first carries .on in the HTML so it shows without JS. -->
    {heroSlides.map((name, i) => (
      <img
        class={i === 0 ? 'hero-slide on' : 'hero-slide'}
        src={`/media/${name}-1280.webp`}
        srcset={heroSrcset(name)}
        sizes="100vw"
        alt={t.hero.alts[i]}
        width="2688" height="1520"
        fetchpriority={i === 0 ? 'high' : 'low'}
        decoding="async" />
    ))}
  </div>
  <div class="hero-meta">
    {t.heroMeta.map((m: string) => <span>{m}</span>)}
  </div>
  <div class="hero-block">
    <h1 class="reveal">{t.hero.lines.map((l: string) => <span>{l}</span>)}</h1>
  </div>
  {heroSlides.length > 1 && (
    <div class="hero-nav" role="group" aria-label={t.hero.slideLabel}>
      {heroSlides.map((_, i) => (
        <button
          type="button"
          class={i === 0 ? 'hero-dot on' : 'hero-dot'}
          aria-label={`${t.hero.slideLabel} ${i + 1}`}
          aria-current={i === 0 ? 'true' : 'false'}><span class="bar"><i></i></span></button>
      ))}
    </div>
  )}
</section>

<!-- ============ NATURE / SLOGAN ============ -->
<div class="wrap">
  <section class="nature">
    <div class="nature-media" aria-hidden="true">
      <!-- Decorative, below the fold. Deliberately NO autoplay attribute: with it, Chrome's
           autoplay policy overrides preload="none" and pulls the whole file during first
           paint (measured: 727 KB at 49 ms). The observer below starts playback instead,
           so nothing is fetched until the block is actually approached. AV1 first, VP9 for
           Safari, poster for anything that can decode neither. -->
      <video class="tree-mask" id="canopy" width="1096" height="1120" poster="/media/tree-canopy-poster.webp"
             muted loop playsinline preload="none">
        <source src="/media/tree-canopy.webm" type="video/webm; codecs=av01.0.05M.08" />
        <source src="/media/tree-canopy.vp9.webm" type="video/webm; codecs=vp9" />
      </video>
    </div>
    <div class="nature-text">
      <h2>{t.slogan.pre}<em>{t.slogan.green}</em>{t.slogan.post}</h2>
      <p>{t.slogan.body}</p>
    </div>
  </section>
</div>
<hr class="rule" />

<!-- ============ PRODUKTE (overview) ============ -->
<section id="produkte">
  <div class="wrap sec">
    <div class="sec-head">
      <h2>{t.products.heading}</h2>
      <div class="aside">{t.products.aside}</div>
    </div>
    <div class="groups">
      {t.products.groups.map((g: any) => (
        <div class="group">
          <h3>{g.name}</h3>
          <div class="g-body">
            <p>{g.body}</p>
            <div class="g-items">{g.items.join(' · ')}</div>
          </div>
        </div>
      ))}
    </div>
    <p class="more"><a href={pageHref('produkte')}>{t.products.more} →</a></p>
  </div>
</section>

<!-- ============ BAND (photo placeholder) ============ -->
<figure class="band">
  <img src="/media/basalt-8-11-strip.webp" width="2000" height="334" alt={t.band.caption} loading="lazy" decoding="async">
  <figcaption>{t.band.caption}</figcaption>
</figure>

<!-- ============ ANWENDUNGEN ============ -->
<section id="anwendungen">
  <div class="wrap sec">
    <div class="sec-head">
      <h2>{t.applications.heading}</h2>
      <div class="aside">{t.applications.aside}</div>
    </div>
    <div class="apps">
      {t.applications.items.map((a: any) => (
        <div class="app">
          <h3>{a.title}</h3>
          <p>{a.body}</p>
          <div class="rocks">{a.rocks}</div>
        </div>
      ))}
    </div>
  </div>
</section>
<hr class="rule" />

<!-- ============ TECHNIK ============ -->
<section id="technik">
  <div class="wrap sec">
    <div class="sec-head">
      <h2>{t.technik.heading}</h2>
      <div class="aside">{t.technik.aside}</div>
    </div>
    <div class="spec">
      {t.technik.columns.map((col: any) => (
        <div class="spec-col">
          <h4>{col.head}</h4>
          <ul>
            {col.rows.map((r: any) => <li><span>{r.k}</span>{r.v && <b>{r.v}</b>}</li>)}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
<hr class="rule" />

<!-- ============ UNTERNEHMEN (overview) ============ -->
<section id="unternehmen">
  <div class="wrap sec">
    <div class="sec-head">
      <h2>{t.company.heading}</h2>
      <div class="aside">{t.company.aside}</div>
    </div>
    <div class="company" style="margin-top:44px">
      <div class="txt">
        {t.company.paras.map((p: string) => <p>{p}</p>)}
        <p class="more"><a href={pageHref('unternehmen')}>{t.company.more} →</a></p>
      </div>
      <div class="facts">
        {t.company.facts.map((f: any) => (
          <div class="fact"><div class="v">{f.v}</div><div class="l">{f.l}</div></div>
        ))}
      </div>
    </div>
  </div>
</section>
<hr class="rule" />

<!-- ============ PARTNER ============ -->
<section id="partner">
  <div class="wrap sec">
    <div class="sec-head">
      <h2>{t.partners.heading}</h2>
      <div class="aside">{t.partners.aside}</div>
    </div>
    <div class="logos">
      {t.partners.slots.map((label: string) => (
        <div class="logo-ph"><span>{label}</span></div>
      ))}
    </div>
  </div>
</section>

<!-- ============ MAP ============ -->
<section id="karte">
  <div class="wrap sec" style="padding-bottom:0">
    <div class="sec-head">
      <h2>{t.map.heading}</h2>
      <div class="aside">{t.map.aside}</div>
    </div>
  </div>
  <div class="mapwrap">
    <iframe
      title={t.map.heading}
      src="https://www.openstreetmap.org/export/embed.html?bbox=7.3148%2C50.3616%2C7.3748%2C50.3916&layer=mapnik&marker=50.3766%2C7.3448"
      loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
    <span class="map-credit">© OpenStreetMap</span>
  </div>
</section>

<!-- ============ KONTAKT (overview) ============ -->
<section id="kontakt">
  <div class="wrap sec">
    <div class="contact">
      <div class="c-main">
        <h3>{t.contact.heading}</h3>
        <p class="lead">{t.contact.lead}</p>
        <a class="btn" href={pageHref('kontakt')}><span>{t.contact.cta}</span><span class="arw">→</span></a>
        <dl class="cdl">
          {t.contact.rows.map((r: any) => (<Fragment><dt>{r.k}</dt><dd>{r.v}</dd></Fragment>))}
        </dl>
      </div>
      <div class="c-side">
        <div class="label">{t.contact.standortLabel}</div>
        <address>
          {t.contact.address.map((line: string, i: number) => (<Fragment>{i > 0 && <br />}{line}</Fragment>))}
        </address>
      </div>
    </div>
  </div>
</section>

<SiteFooter t={t} locale={locale} />

<script is:inline>
  // Load and play the canopy loop only once it is approached. Keeps 727 KB off the
  // first paint, and leaves the poster in place for reduced-motion users.
  (function () {
    var v = document.getElementById('canopy');
    if (!v) return;
    if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!('IntersectionObserver' in window)) { v.play().catch(function () {}); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (!e.isIntersecting) return;
        io.disconnect();
        v.preload = 'auto';
        v.play().catch(function () {});
      });
    }, { rootMargin: '300px 0px' });
    io.observe(v);
  })();

  // Hero stills cross-fade every 5s, with the indicator bars kept in sync. The interval
  // starts on window.load so the first swap can never fade into an image that has not
  // arrived yet. Held still under reduced motion, where the bars are filled by CSS.
  (function () {
    var slides = document.querySelectorAll('.hero-slide');
    var dots = document.querySelectorAll('.hero-dot');
    if (slides.length < 2) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var i = 0, timer = null;

    function show(n) {
      slides[i].classList.remove('on');
      if (dots[i]) { dots[i].classList.remove('on'); dots[i].setAttribute('aria-current', 'false'); }
      i = (n + slides.length) % slides.length;
      slides[i].classList.add('on');
      if (dots[i]) { dots[i].classList.add('on'); dots[i].setAttribute('aria-current', 'true'); }
    }
    function play() {
      clearInterval(timer);
      timer = setInterval(function () { show(i + 1); }, 5000);
    }

    Array.prototype.forEach.call(dots, function (d, n) {
      d.addEventListener('click', function () {
        if (n === i) return;
        show(n);
        if (!reduce) play();
      });
    });

    if (reduce) return;
    if (document.readyState === 'complete') play();
    else window.addEventListener('load', play);
  })();
</script>
