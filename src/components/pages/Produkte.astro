---
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
interface Props { t: any; locale: string; }
const { t, locale } = Astro.props;
const p = t.pages.produkte;

// Category photos, positionally matched to pages.produkte.categories (locale-independent).
// Keep this array the same length and order as that list in EVERY locale file.
// null = no photograph yet; the grey labelled placeholder renders instead.
const catImages = [
  '/media/products/stone_powder.webp', // Rohstoffe für die Beton- und Zementindustrie
  null,                                // Technische Anwendungen — client photo still missing
  '/media/zementverladung-768.webp',   // Internationales Rohstoff Sourcing (small box, lazy)
];
---

<SiteHeader t={t} locale={locale} slug={p.slug} />

<div class="wrap">
  <div class="page-head">
    <h1>{p.title}</h1>
    <p>{p.lead}</p>
  </div>
  <div class="cats">
    {p.categories.map((c: any, i: number) => (
      <div class="cat">
        <div class="cat-img">
          {catImages[i]
            ? <img src={catImages[i]} alt={c.name} loading="lazy" decoding="async" />
            : <div class="ph"><span class="ph-label">{c.imageLabel[1]}</span></div>}
        </div>
        <div class="cat-body">
          <h3>{c.name}</h3>
          <p>{c.body}</p>
          {c.items && c.items.length > 0 && (
            <ul class="items">{c.items.map((it: string) => <li>{it}</li>)}</ul>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<SiteFooter t={t} locale={locale} />
