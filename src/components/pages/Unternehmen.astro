---
import SiteHeader from '../SiteHeader.astro';
import SiteFooter from '../SiteFooter.astro';
interface Props { t: any; locale: string; }
const { t, locale } = Astro.props;
const p = t.pages.unternehmen;
---

<SiteHeader t={t} locale={locale} slug={p.slug} />

<div class="wrap">
  <div class="page-head">
    <h1>{p.title}</h1>
    <p>{p.lead}</p>
  </div>
  <div class="co-grid">
    <aside class="co-owner">
      <div class="co-portrait">
        <img src="/media/owner.webp" alt={p.inhaber.name} loading="lazy" decoding="async" />
      </div>
      <div class="co-owner-body">
        <div class="label">{p.inhaber.heading}</div>
        <div class="o-name">{p.inhaber.name}</div>
        <p>{p.inhaber.body}</p>
      </div>
    </aside>
    <div class="co-text">
      {p.blocks.map((b: any) => (
        <div class="co-block"><h3>{b.heading}</h3><div class="b">{b.body}</div></div>
      ))}
    </div>
  </div>
</div>

<SiteFooter t={t} locale={locale} />
