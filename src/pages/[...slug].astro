---
import Layout from '../layouts/Layout.astro';
import Unternehmen from '../components/pages/Unternehmen.astro';
import Produkte from '../components/pages/Produkte.astro';
import Leistungen from '../components/pages/Leistungen.astro';
import Kontakt from '../components/pages/Kontakt.astro';
import Legal from '../components/pages/Legal.astro';
import * as de from '../i18n/de';
import * as en from '../i18n/en';
import * as fr from '../i18n/fr';

const mods: Record<string, any> = { de, en, fr };
const contentPages = ['unternehmen', 'produkte', 'leistungen', 'kontakt'];
const legalPages = ['impressum', 'datenschutz', 'cookies'];

export function getStaticPaths() {
  const codes = ['de', 'en', 'fr'];
  const pages = ['unternehmen', 'produkte', 'leistungen', 'kontakt', 'impressum', 'datenschutz', 'cookies'];
  const paths = [];
  for (const code of codes) {
    const prefix = code === 'de' ? '' : `${code}/`;
    for (const page of pages) {
      paths.push({ params: { slug: `${prefix}${page}` }, props: { code, page } });
    }
  }
  return paths;
}

const { code, page } = Astro.props;
const mod = mods[code];
const t = mod.content;
const isLegal = legalPages.includes(page);
const pageData = isLegal ? t.pages.legal[page] : t.pages[page];
const title = `${pageData.title} · Baustoffe Breitbach e.K.`;
---

<Layout lang={mod.lang} title={title} description={mod.meta.description}>
  {page === 'unternehmen' && <Unternehmen t={t} locale={code} />}
  {page === 'produkte' && <Produkte t={t} locale={code} />}
  {page === 'leistungen' && <Leistungen t={t} locale={code} />}
  {page === 'kontakt' && <Kontakt t={t} locale={code} />}
  {isLegal && <Legal t={t} locale={code} which={page} />}
</Layout>
